# Partner Portal environment variables
# Copy this file to .env for local development and fill in real values there,
# or set the same names in hosting. Never commit .env or live credentials.

# Session signing secret. Generate a new random value.
AUTH_SECRET=

# Public base URL of this app. Auth cookie security checks read this value.
AUTH_URL=

# Postgres connection string. Use a rotated database password.
DATABASE_URL=

# Optional. Comma-separated browser origins allowed by CORS.
# CORS_ORIGINS=http://localhost:3000

# Optional Create.xyz integration
# NEXT_PUBLIC_CREATE_BASE_URL=
# NEXT_PUBLIC_CREATE_HOST=
# NEXT_PUBLIC_PROJECT_GROUP_ID=
